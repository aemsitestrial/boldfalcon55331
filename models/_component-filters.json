          "sections": ["blocks", "format", "sr_script", "list", "insert", "editor"]
        }
      }
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "./_cta.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
